     "additional_info.off_nadir_deg": "off_nadir_deg",
     "insights.post_comment": "analyst_note",
     "insights.transcription": "detected_objects"
    }
   },
   {
    "source_applications": [
     "ADINT"
    ],
    "recent_days": 365,
    "limit": 300,
    "layer": "ADINT",
    "fields": [
